{
  "name": "rag-video-prompts",
  "version": "1.0.0",
  "description": "RAG-System für KI-Videoproduktion: Szenario → FLUX → LTX → ComfyUI — TypeScript/Vite port",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "start:backend": "tsx src/backend/server.ts",
    "db:update": "tsx src/backend/scripts/update_db.ts",
    "db:stats": "tsx src/backend/scripts/stats.ts",
    "db:index": "tsx src/backend/scripts/rag_index.ts"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.7.7",
    "chromadb": "^1.8.2",
    "dotenv": "^16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
