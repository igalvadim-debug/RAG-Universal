# ──────────────────────────────────────────────
# RAG — пример конфигурации. Скопируйте в .env и заполните ключи:
#     cp .env.example .env      (Windows: copy .env.example .env)
# Файл .env НЕ коммитится (см. .gitignore).
# Именование ключей унифицировано: <PROVIDER>_API_KEY
# ──────────────────────────────────────────────

# Облачные LLM-провайдеры — достаточно одного ключа,
# система возьмёт первый заполненный (порядок см. rag_config.CLOUD_PROVIDERS)
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
ODIROUTER_API_KEY=
AGNES_API_KEY=

# ──────────────────────────────────────────────
# Пути и база (опционально, значения по умолчанию в rag_config.py)
# ──────────────────────────────────────────────
# RAG_DB=D:\claudeAgent\RAG\chroma_zaebalo
# RAG_COLLECTION=zaebalo
# COMFY_INPUT_DIR=D:\ComfyUiVid\input

