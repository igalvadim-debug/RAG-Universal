      "properties": {
        "aux_id": "CGlide/WhatDreamsCost-CSGlide",
        "ver": "9f933b3c21128ca587f2144f4bb899e7fada12c8",
        "Node name for S&R": "LTXDirectorCS",
        "global_prompt": "masterpiece, cinematic lighting, ultra realistic, volumetric lighting, soft shadows, dramatic atmosphere, 4K.",
        "mainTrackEnabled": true,
        "audioTrackEnabled": true,
        "motionTrackEnabled": true,
        "audioTrackWasEnabledBeforeOverride": false,
        "inpaint_audio": true,
        "override_audio": false,
        "overrideAudio": false,
        "showFilenames": true,
        "showPromptZones": true,
        "use_custom_audio": true,
        "use_custom_motion": true,
        "frame_rate": 24,
        "display_mode": "seconds",
        "custom_width": 768,
        "custom_height": 512,
        "resize_method": "maintain aspect ratio",
        "divisible_by": 32,
        "img_compression": 18,
        "guide_strength": "1.00,1.00,1.00,1.00,1.00",
        "local_prompts": "Little Red Riding Hood walks through the forest carrying bread and wine.\nLittle Red Riding Hood walking along a mysterious forest path carrying a basket with bread and wine, cinematic fairy-tale atmosphere, soft sunlight through tall trees, realistic style, detailed environment. \nSlow cinematic tracking shot from behind following her through the forest, gentle handheld movement, occasional side dolly shots through branches. \nThe girl says: “Grandma will love these treats.”.\n\n | The wolf stalks Little Red Riding Hood on the way.\nA dark wolf secretly stalking Little Red Riding Hood through dense forest bushes, suspenseful mood, realistic cinematic lighting, fog between trees. Low-angle predator POV camera moving stealthily through bushes, telephoto shots revealing the wolf watching from shadows. \nThe wolf says: “What a delicious little visitor…”. | The wolf meets and gives a flower to Little Red Riding Hood.\nThe wolf pretending to be friendly while giving a flower to Little Red Riding Hood on a forest path, magical but unsettling atmosphere, cinematic realism. Smooth circular orbit camera around both characters, slow push-in close-up on the flower exchange. \nThe wolf says: “For you, little lady.”’ | The wolf runs through the forest to Grandma’s house.\nThe wolf sprinting rapidly through the dark forest toward Grandma’s cottage, intense cinematic energy, leaves flying, dramatic lighting. Fast tracking shot alongside the wolf running, dynamic shaky cam, fast whip pans creating speed and urgency. \nThe wolf says: “I’ll get there first!”. | Grandma opens the door for the wolf.\nInside a cozy old cottage, Grandma slowly opening the wooden door at night, warm candlelight contrasting with darkness outside, suspenseful atmosphere. Slow dolly-in toward the door from inside the hallway, over-the-shoulder shot behind Grandma as the wolf appears outside. \nThe Grandma says: “Oh dear, who’s there?”.",
        "segment_lengths": "139,150,142,145,144",
        "timeline_data": "{\"mainTrackEnabled\":true,\"audioTrackEnabled\":true,\"motionTrackEnabled\":true,\"propHeight\":90,\"globalPropHeight\":60,\"showFilenames\":true,\"showPromptZones\":true,\"overrideAudio\":false,\"inpaint_audio\":true,\"global_prompt\":\"masterpiece, cinematic lighting, ultra realistic, volumetric lighting, soft shadows, dramatic atmosphere, 4K.\",\"retake_global_prompt\":\"\",\"retakeMode\":false,\"retakeStart\":24,\"retakeLength\":48,\"retakePrompt\":\"\",\"retakeStrength\":1,\"retakeVideo\":null,\"normalStartFrame\":0,\"normalDurationFrames\":720,\"reference_mode\":\"Ghost Mask (End)\",\"disable_prompt_relay\":false,\"msr_prefix_frames\":41,\"analyzeProvider\":\"custom\",\"analyzeBaseUrl\":\"http://127.0.0.1:8080\",\"analyzeModel\":\"Qwen3-VL-4B-Instruct-abliterated.Q8_0.gguf\",\"characters\":[{\"images\":[{\"name\":\"whatdreamscost/ltxref_wolf_1786272442740.jpg\"}],\"description\":\"Black wolf creature. Wet, glossy black fur with sharp, erect ears and piercing amber eyes. Muscular build with long, bushy tail and visible claws.\"},{\"images\":[],\"description\":\"\"},{\"images\":[],\"description\":\"\"}],\"segments\":[{\"id\":\"1786132759543xpgsw\",\"start\":0,\"length\":139,\"prompt\":\"Little Red Riding Hood walks through the forest carrying bread and wine.\\nLittle Red Riding Hood walking along a mysterious forest path carrying a basket with bread and wine, cinematic fairy-tale atmosphere, soft sunlight through tall trees, realistic style, detailed environment. \\nSlow cinematic tracking shot from behind following her through the forest, gentle handheld movement, occasional side dolly shots through branches. \\nThe girl says: “Grandma will love these treats.”.\\n\\n\",\"type\":\"image\",\"isAnchor\":false,\"imageFile\":\"whatdreamscost/1.png\",\"imageB64\":\"/api/view?filename=1.png&type=input&subfolder=whatdreamscost\",\"isEndFrame\":false},{\"id\":\"1786133082316575tl\",\"start\":139,\"length\":150,\"prompt\":\"The wolf stalks Little Red Riding Hood on the way.\\nA dark wolf secretly stalking Little Red Riding Hood through dense forest bushes, suspenseful mood, realistic cinematic lighting, fog between trees. Low-angle predator POV camera moving stealthily through bushes, telephoto shots revealing the wolf watching from shadows. \\nThe wolf says: “What a delicious little visitor…”.\",\"type\":\"image\",\"isAnchor\":false,\"imageFile\":\"whatdreamscost/2.png\",\"imageB64\":\"/api/view?filename=2.png&type=input&subfolder=whatdreamscost\",\"isEndFrame\":false},{\"id\":\"1786133091248rdi0f\",\"start\":289,\"length\":142,\"prompt\":\"The wolf meets and gives a flower to Little Red Riding Hood.\\nThe wolf pretending to be friendly while giving a flower to Little Red Riding Hood on a forest path, magical but unsettling atmosphere, cinematic realism. Smooth circular orbit camera around both characters, slow push-in close-up on the flower exchange. \\nThe wolf says: “For you, little lady.”’\",\"type\":\"image\",\"isAnchor\":false,\"imageFile\":\"whatdreamscost/3.png\",\"imageB64\":\"/api/view?filename=3.png&type=input&subfolder=whatdreamscost\",\"isEndFrame\":false},{\"id\":\"1786133098928i3p66\",\"start\":431,\"length\":145,\"prompt\":\"The wolf runs through the forest to Grandma’s house.\\nThe wolf sprinting rapidly through the dark forest toward Grandma’s cottage, intense cinematic energy, leaves flying, dramatic lighting. Fast tracking shot alongside the wolf running, dynamic shaky cam, fast whip pans creating speed and urgency. \\nThe wolf says: “I’ll get there first!”.\",\"type\":\"image\",\"isAnchor\":false,\"imageFile\":\"whatdreamscost/4.png\",\"imageB64\":\"/api/view?filename=4.png&type=input&subfolder=whatdreamscost\",\"isEndFrame\":false},{\"id\":\"17861331057979tld3\",\"start\":576,\"length\":144,\"prompt\":\"Grandma opens the door for the wolf.\\nInside a cozy old cottage, Grandma slowly opening the wooden door at night, warm candlelight contrasting with darkness outside, suspenseful atmosphere. Slow dolly-in toward the door from inside the hallway, over-the-shoulder shot behind Grandma as the wolf appears outside. \\nThe Grandma says: “Oh dear, who’s there?”.\",\"type\":\"image\",\"isAnchor\":false,\"imageFile\":\"whatdreamscost/5.png\",\"imageB64\":\"/api/view?filename=5.png&type=input&subfolder=whatdreamscost\",\"isEndFrame\":false}],\"motionSegments\":[],\"audioSegments\":[]}",
