        "properties": {
            "n": {"type": "integer"},
            "bbox_2d": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
        },
        "required": ["n", "bbox_2d"],
        "additionalProperties": False,
    },
}


_log_cb = None   # optionaler Callback (z.B. fuer die Gradio-Oberflaeche)


def log(msg: str) -> None:
    print(msg, flush=True)
    if _log_cb is not None:
        try:
            _log_cb(msg)
        except Exception:
            pass


# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
def server_has_vision(port: int) -> bool:
    try:
        r = requests.get(f"http://127.0.0.1:{port}/props", timeout=2)
        if r.status_code != 200:
            return False
        return bool(r.json().get("modalities", {}).get("vision"))
    except Exception:
        return False


def free_vram_mib() -> int | None:
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=10,
        ).stdout
        return int(out.strip().splitlines()[0])
    except Exception:
        return None


def start_server(ngl_arg: int | None, vl: str) -> subprocess.Popen:
    VL_MODEL, VL_MMPROJ = VL_SETS[vl]
    for p, what in ((SERVER_EXE, "llama-server.exe"), (VL_MODEL, "Vision-Modell"), (VL_MMPROJ, "mmproj")):
        if not p.exists():
            raise RuntimeError(f"[FEHLER] {what} nicht gefunden: {p}")

    free = free_vram_mib()
    if ngl_arg is not None:
        ngl = ngl_arg
    else:
        # Modell (~4 GB) + mmproj + Kontext brauchen ~6 GB freien VRAM, sonst auf CPU ausweichen
        ngl = 99 if (free is None or free >= 6000) else 0
    log(f"[INFO] Freier VRAM: {free if free is not None else '?'} MiB -> GPU-Layer: {ngl}"
        + ("  (CPU-Modus, dauert laenger)" if ngl == 0 else ""))

    cmd = [
        str(SERVER_EXE),
        "-m", str(VL_MODEL),
        "--mmproj", str(VL_MMPROJ),
        "-c", "16384",
        "--cache-type-k", "q8_0",
        "--cache-type-v", "q8_0",
        "-np", "1",
        "-ngl", str(ngl),
        "-fa", "on",
        "--jinja",
        "--host", "127.0.0.1",
        "--port", str(VL_PORT),
        "--temp", "0.1",
        "--top-k", "20",
    ]
    cmd.append("--mmproj-offload" if ngl > 0 else "--no-mmproj-offload")

    log(f"[INFO] Starte llama-server ({VL_MODEL.name} + mmproj) auf Port {VL_PORT} ...")
    logf = open(SERVER_LOG, "w", encoding="utf-8", errors="replace")
    flags = getattr(subprocess, "CREATE_NO_WINDOW", 0)
    proc = subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT, creationflags=flags)

    t0 = time.time()
    while time.time() - t0 < 360:
        if proc.poll() is not None:
            tail = ""
            try:
                tail = "\n".join(SERVER_LOG.read_text(encoding="utf-8", errors="replace").splitlines()[-15:])
            except Exception:
                pass
            raise RuntimeError(f"[FEHLER] llama-server ist beendet (Code {proc.returncode}). Log-Ende:\n{tail}")
        try:
            r = requests.get(f"http://127.0.0.1:{VL_PORT}/health", timeout=2)
            if r.status_code == 200:
                log(f"[OK] Server bereit nach {time.time() - t0:.0f}s")
                return proc
        except Exception:
            pass
        time.sleep(1.5)
    proc.terminate()
    raise RuntimeError("[FEHLER] llama-server wurde nicht rechtzeitig bereit.")


def stop_server(proc: subprocess.Popen | None) -> None:
    if proc is None or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=15)
    except Exception:
        proc.kill()


# ----------------------------------------------------------------------------
# Modellabfrage und Auswertung
# ----------------------------------------------------------------------------
def ask_model(port: int, img: Image.Image, attempt: int) -> tuple[str, tuple[int, int]]:
    W, H = img.size
    scale = min(1.0, 1600 / max(W, H))
    send = img.convert("RGB")
    if scale < 1:
        send = send.resize((round(W * scale), round(H * scale)), Image.LANCZOS)
    buf = io.BytesIO()
    send.save(buf, "JPEG", quality=92)
    b64 = base64.b64encode(buf.getvalue()).decode("ascii")

    payload = {
        "messages": [{
            "role": "user",
            "content": [
                {"type": "image_url", "image_url": {"url": "data:image/jpeg;base64," + b64}},
                {"type": "text", "text": PROMPT},
            ],
        }],
        "temperature": 0.1 if attempt == 0 else 0.4,
        "max_tokens": 1200,
        "stream": False,
        # Grammatik-Zwang: verhindert Endlosschleifen und kaputtes JSON beim kleinen Modell
        "response_format": {"type": "json_schema", "json_schema": {"name": "panels", "strict": True, "schema": PANELS_SCHEMA}},
    }
    r = requests.post(f"http://127.0.0.1:{port}/v1/chat/completions", json=payload, timeout=1200)
    r.raise_for_status()
    return r.json()["choices"][0]["message"]["content"], send.size


def parse_boxes(text: str, sent_size: tuple[int, int], orig_size: tuple[int, int]) -> list[tuple[int, int, int, int]]:
    text = re.sub(r"```(?:json)?", "", text)
    a, b = text.find("["), text.rfind("]")
    if a < 0 or b <= a:
        return []
    try:
        data = json.loads(text[a:b + 1])
    except Exception:
        return []

    raw: list[list[float]] = []
    for it in data:
        box = None
        if isinstance(it, dict):
            box = it.get("bbox_2d") or it.get("bbox") or it.get("box")
        elif isinstance(it, (list, tuple)):
            box = it
        if isinstance(box, (list, tuple)) and len(box) == 4 and all(isinstance(v, (int, float)) for v in box):
            raw.append([float(v) for v in box])
    if not raw:
        return []

    W, H = orig_size
    sw, sh = sent_size
    biggest = max(max(bx) for bx in raw)
    out = []
    for x1, y1, x2, y2 in raw:
        if biggest <= 1000.5:                      # relative Koordinaten 0..1000
            fx, fy = W / 1000.0, H / 1000.0
        else:                                      # Pixel des gesendeten Bildes
            fx, fy = W / sw, H / sh
        l, r = sorted((x1 * fx, x2 * fx))
        t, bt = sorted((y1 * fy, y2 * fy))
        out.append((int(round(l)), int(round(t)), int(round(r)), int(round(bt))))
    return out


def iou(a, b) -> float:
    ix = max(0, min(a[2], b[2]) - max(a[0], b[0]))
    iy = max(0, min(a[3], b[3]) - max(a[1], b[1]))
    inter = ix * iy
    ua = (a[2] - a[0]) * (a[3] - a[1]) + (b[2] - b[0]) * (b[3] - b[1]) - inter
    return inter / ua if ua > 0 else 0.0


def validate(boxes, W, H) -> list[tuple[int, int, int, int]] | None:
    clean = []
    for l, t, r, b in boxes:
        l, t, r, b = max(0, l), max(0, t), min(W, r), min(H, b)
        if (r - l) < 0.05 * W or (b - t) < 0.03 * H:
            continue
        if any(iou((l, t, r, b), c) > 0.6 for c in clean):
            continue
        clean.append((l, t, r, b))
    if len(clean) < 2:
        return None
    # Gitterzellen sind annaehernd gleich gross - sonst ist die Antwort des Modells unbrauchbar
    ws = sorted(c[2] - c[0] for c in clean)
    hs = sorted(c[3] - c[1] for c in clean)
    mw, mh = ws[len(ws) // 2], hs[len(hs) // 2]
    if any(abs((c[2] - c[0]) - mw) > 0.25 * mw or abs((c[3] - c[1]) - mh) > 0.25 * mh for c in clean):
        return None
    for i in range(len(clean)):
        for j in range(i + 1, len(clean)):
            if iou(clean[i], clean[j]) > 0.2:
                return None
    return clean


# ----------------------------------------------------------------------------
# Kanten einrasten (sauberer Schnitt)
# ----------------------------------------------------------------------------
def _edge(profile: np.ndarray, pos: int, win: int) -> int:
    """Sucht im Fenster um pos die staerkste Helligkeitskante (die naechste unter den starken)."""
    n = len(profile)
    lo, hi = max(1, pos - win), min(n - 1, pos + win)
    if hi - lo < 2:
        return pos
    d = np.abs(np.diff(profile.astype(np.float32)))      # d[i] = Kante zwischen Pixel i und i+1
    seg = d[lo - 1:hi]                                   # Kanten an Position lo..hi
    peak = float(seg.max())
    if peak < 4.0:
        return pos
    idx = np.nonzero(seg >= 0.5 * peak)[0]
    k = idx[int(np.argmin(np.abs(idx - (pos - lo))))]
    return lo + int(k)


def bg_mask(img: Image.Image) -> np.ndarray:
    """Bool-Maske: True = Pixel hat Hintergrundfarbe (Farbe aus den Bildraendern)."""
    arr = np.asarray(img.convert("RGB")).astype(np.int16)
    k = 3
    strips = np.concatenate([
        arr[:k].reshape(-1, 3), arr[-k:].reshape(-1, 3),
        arr[:, :k].reshape(-1, 3), arr[:, -k:].reshape(-1, 3),
    ])
    bg = np.median(strips, axis=0)
    return np.abs(arr - bg).max(axis=2) < 16


def _gutter_edge(frac: np.ndarray, uni: np.ndarray, pos: int, win: int, low_side: bool) -> int | None:
    """Findet die Zwischenraum-Rinne (fast reiner Hintergrund) nahe pos und liefert die Panel-Kante daran."""
    n = len(frac)
    lo, hi = max(0, pos - win), min(n - 1, pos + win)
    g = frac[lo:hi + 1] >= 0.98
    runs, i = [], 0
    while i < len(g):
        if g[i]:
            j = i
            while j + 1 < len(g) and g[j + 1]:
                j += 1
            runs.append((lo + i, lo + j))
            i = j + 1
        else:
            i += 1
    runs = [r for r in runs if (r[1] - r[0] + 1) >= 3 or r[0] == 0 or r[1] == n - 1]
    if not runs:
        return None

    # Echte Rinne: beidseitig von einer gleichmaessigen Linie (Rahmen) oder dem Bildrand begrenzt.
    # Leerer Platz innerhalb einer Beschriftung hat auf der Textseite keine solche Linie.
    def flanked(r):
        a_ok = r[0] == 0 or bool(uni[r[0] - 1])
        b_ok = r[1] == n - 1 or bool(uni[r[1] + 1])
        return a_ok and b_ok

    good = [r for r in runs if flanked(r)]
    runs = good or runs

    def dist(r):
        return 0 if r[0] <= pos <= r[1] else min(abs(pos - r[0]), abs(pos - r[1]))

    r = min(runs, key=dist)
    if low_side:
        return None if r[1] >= hi else r[1] + 1
    return None if r[0] <= lo and lo > 0 else r[0]


def snap_box(gray: np.ndarray, mask: np.ndarray, box, W: int, H: int):
    """Rastet die vier Kanten ein: zuerst an der Hintergrund-Rinne, sonst an der staerksten Helligkeitskante."""
    l, t, r, b = box
    win_e = max(8, int(0.02 * max(W, H)))
    win_g = max(12, int(0.03 * max(W, H)))
    bh, bw = b - t, r - l
    y0, y1 = t + int(0.1 * bh), b - int(0.1 * bh)
    x0, x1 = l + int(0.1 * bw), r - int(0.1 * bw)
    if y1 - y0 < 4 or x1 - x0 < 4:
        return box
    cols_g, rows_g = mask[y0:y1, :].mean(axis=0), mask[:, x0:x1].mean(axis=1)
    cols_e, rows_e = gray[y0:y1, :].mean(axis=0), gray[:, x0:x1].mean(axis=1)
    cols_u, rows_u = gray[y0:y1, :].std(axis=0) < 20, gray[:, x0:x1].std(axis=1) < 20

    def one(fr, un, pr, pos, low):
        e = _gutter_edge(fr, un, pos, win_g, low)
        return e if e is not None else _edge(pr, pos, win_e)

    nl, nr = one(cols_g, cols_u, cols_e, l, True), one(cols_g, cols_u, cols_e, r, False)
    nt, nb = one(rows_g, rows_u, rows_e, t, True), one(rows_g, rows_u, rows_e, b, False)
    if nr - nl < 0.5 * bw or nb - nt < 0.5 * bh:
        return box
    return (max(0, nl), max(0, nt), min(W, nr), min(H, nb))


def sort_boxes(boxes):
    heights = sorted(b[3] - b[1] for b in boxes)
    med_h = heights[len(heights) // 2]
    rows: list[list] = []
    for bx in sorted(boxes, key=lambda b: (b[1] + b[3]) / 2):
        cy = (bx[1] + bx[3]) / 2
        if rows and abs(cy - np.mean([(q[1] + q[3]) / 2 for q in rows[-1]])) < 0.5 * med_h:
            rows[-1].append(bx)
        else:
            rows.append([bx])
    ordered = []
    for row in rows:
        ordered.extend(sorted(row, key=lambda b: b[0]))
    return ordered


def _runs(flags: np.ndarray, min_len: int = 1) -> list[tuple[int, int]]:
    """Zusammenhaengende True-Laueufe als (start, ende_exklusiv); kuerzere als min_len entfallen."""
    runs = []
    i, n = 0, len(flags)
    while i < n:
        if flags[i]:
            j = i
            while j + 1 < n and flags[j + 1]:
                j += 1
            if j + 1 - i >= min_len:
                runs.append((i, j + 1))
            i = j + 1
        else:
            i += 1
    return runs


def _merge_runs(runs: list[tuple[int, int]], gap: int) -> list[tuple[int, int]]:
    """Laueufe verbinden, deren Abstand kleiner als gap ist."""
    out: list[list[int]] = []
    for s, e in runs:
        if out and s - out[-1][1] < gap:
            out[-1][1] = max(out[-1][1], e)
        else:
            out.append([s, e])
    return [(s, e) for s, e in out]


def _strong_edge(profile: np.ndarray, pos: int, win: int, thr: float = 0.015) -> int | None:
    """Staerkste Kante (Gradient) im Fenster um pos; Rueckgabe immer in [pos-2, pos+2].

    Der Ausschlag muss deutlich sein und die staerkste Kante des Fensters
    darf hoechstens zwei Pixel von pos entfernt liegen. Die Kantenposition
    ist der Beginn des Abfalls: d[i] = |profil[i+1] - profil[i]|, damit ein
    Schnitt nie tiefer als noetig faellt und keine Textzeile stehen bleibt.

    ``profile`` sind normalisierte Deckungsgrade in [0, 1] (Anteil Inhalts-
    pixel pro Zeile/Spalte). Der Schwellwert wird entsprechend skaliert:
    eine halbe Inhaltsspalte (= 0.5 * thr) gilt als deutlicher Ausschlag.
    """
    n = len(profile)
    lo, hi = max(1, pos - win), min(n - 1, pos + win)
    if hi - lo < 2:
        return None
    d = np.abs(np.diff(profile.astype(np.float32)))   # d[i] = Kante zwischen i und i+1
    seg = d[lo - 1:hi - 1]
    peak = float(seg.max())
    if peak < 0.5 * thr:
        return None
    best = int(np.argmax(seg))                        # Kantenindex relativ zu lo-1
    edge = lo + best                                  # absoluter Positionsanfang
    if abs(edge - pos) > 2:
        return None
    idx = np.nonzero(seg >= 0.5 * peak)[0]
    k = int(idx[np.argmin(np.abs(lo + idx - edge))])
    return lo + k


def _gap_start(cov: np.ndarray, pos: int, thr: float, reach: int) -> int | None:
    """Start der ersten Hintergrund-Rinne (cov < thr) bei/nach pos, hoechstens reach weit.

    Der Beginn der ersten schwachen Zeile ab pos wird zurueckgegeben, wenn
    er innerhalb von reach Positionen liegt; die Rinne darf bis ans Ende
    laufen. Wird keine Rinne gefunden, liefert die Funktion None.
    """
    n = len(cov)
    i = max(0, min(n, pos))
    end = min(n, i + reach)
    while i < end:
        if cov[i] < thr:
            return i
        i += 1
    return None


def _split_at_gaps(cov: np.ndarray, thr: float, min_len: int) -> list[tuple[int, int]]:
    """Inhalts-Laueufe; schmale Rinne werden verschmolzen.

    Ein Feld endet erst an einer durchgehenden Hintergrund-Rinne von
    mindestens min_len Zeilen (bzw. Spalten). Duenne Trennlinien wie der
    Rand eines Fotos oder Zeilenabstaende innerhalb einer Beschriftung
    trennen nicht; so bleibt das Foto eine Gruppe und die Caption darunter
    eine eigene.
    """
    runs = _runs(cov >= thr)
    out: list[list[int]] = []
    for s, e in runs:
        if out and s - out[-1][1] < min_len:
            out[-1][1] = max(out[-1][1], e)
        else:
            out.append([s, e])
    return [(s, e) for s, e in out]


def strip_caption(img: Image.Image, gray: np.ndarray, mask: np.ndarray, box, W: int, H: int):
    """Return a panel box cropped to the picture only (caption text removed).

    ``box`` contains (left, top, right, bottom) pixel bounds. ``gray``,
    ``mask`` and ``bg_mask(img)``-style data may be passed for interface
    compatibility but are not required; the decision uses fresh per-panel
    measurements, so panels touching the image border or sitting on a
    differently coloured page are handled like all others.

    The panel's own background colour is measured from its border zone.
    Uniform frame/border bands at the panel edges are detected first and
    excluded from both the background estimate and the content mask, so
    decorative borders never count as content. Rows with hardly any content
    form gaps; the first big content group (the picture) ends at its gap and
    everything below is cut away when what follows looks like text (thin
    lines covering little width). Trimming contract: the crop keeps the
    gutter above the caption and cuts at the image bottom -- the space
    between picture and caption stays inside the result; if no plausible
    picture group is found (blank or fully filled panels) the box is
    returned unchanged. A caption column on the left or right side is
    trimmed from that side instead. Boxes under 40 pixels wide or tall are
    returned unchanged. Input images and arrays are not modified.
    """
    l, t, r, b = box
    bh, bw = b - t, r - l
    if bh < 40 or bw < 40:
        return box

    # Eigene Hintergrundfarbe fuer dieses Panel: Farbe der Randzone des
    # Panels. Die globale Bild-Hintergrundfarbe versagt, wenn das Panel den
    # Bildrand beruehrt oder die Raender andersfarbig sind.
    m = max(2, min(8, int(0.02 * min(bw, bh))))
    par = np.asarray(img.convert("RGB").crop((l, t, r, b))).astype(np.int16)
    h, w = par.shape[:2]
    thr = 0.015                                        # Zeile gilt ab 1.5 % als Inhalt

    # Gleichmaessige Rahmen-/Randbander VOR der Hintergrund-Schaetzung
    # erkennen: ein durchgehender Rand darf weder die Hintergrundfarbe
    # verschieben noch als Inhalt zaehlen. Ein Band ist eine Folge von
    # Linien nahe einer einzigen Farbe (Rahmenlinie oder helle/finstere
    # Rinne), die an beiden Enden vom Panelrand und auf der Innenseite von
    # einer vollen Hintergrundlinie begrenzt wird. Innerhalb von Text oder
    # Bild gibt es solche Begrenzung nicht, dort wird nichts abgetrennt.
    def line_uniform(line: np.ndarray) -> bool:
        """True, wenn eine Zeile/Spalte fast nur aus einer einzigen Farbe besteht."""
        pts = line.reshape(-1, 3)
        med = np.median(pts, axis=0)
        near = (np.abs(pts - med).max(axis=1) < 16)
        return bool(near.mean() >= 0.97 and float(med.max()) - float(med.min()) <= 32)

    def line_gutter(line: np.ndarray) -> bool:
        """True, wenn eine Linie vollflaechig hell oder finster ist (Rinne)."""
        m_ = float(line.mean())
        return m_ > 235 or m_ < 20

    row_full_bg = np.array([line_uniform(par[i]) for i in range(h)])
    col_full_bg = np.array([line_uniform(par[:, j]) for j in range(w)])
    # Linien, die als Rahmenband-Linie in Frage kommen: einfarbig oder
    # vollflaechig hell/finster (breite Rinne am Rand).
    row_band_flags = np.array([line_uniform(par[i]) or line_gutter(par[i]) for i in range(h)])
    col_band_flags = np.array([line_uniform(par[:, j]) or line_gutter(par[:, j]) for j in range(w)])
    # Zusaetzliche Grenzkante: eine Linie ueber dem Span der bereits
    # erkannten senkrechten Bander, deren Pixel fast alle nahe einer einzigen
    # Farbe liegen (z.B. die weisse Rinne zwischen Bild und Beschriftung,
    # wenn seitliche schwarze Baender denselben Wert verschieben wuerden).

    def band(start: int, perp_lo: int, perp_hi: int,
             perp_full: np.ndarray, along: np.ndarray,
             line_edge: np.ndarray) -> list[int]:
        """Linienindex-Folge des Randbands bei `start` (0 oder letzter Index).
        `along` = Uniformitaets-/Rinnenflags der Linien selbst (bei Zeilen
        row_band_flags, bei Spalten col_band_flags); die Traversierung endet
        an der ersten nicht zum Band gehoerigen Linie. `perp_full` = volle
        Hintergrundflags der senkrechten Linien; die Innenbegrenzung wird
        ueber das Span [perp_lo, perp_hi] der bereits erkannten senkrechten
        Bander geprueft, damit ein gueltiges Rahmenband nicht an einzelnen
        Inhaltssenken in Gegenrichtung scheitert. `line_edge` =
        Grenzkantenflags auf der Achse der Band-Linien selbst (ueber den
        Gegen-Span berechnet); sie ersetzen die Flag-Pruefung derselben
        Achse, wenn deren Median durch seitliche Baender verschoben wird.
        Leere Liste = kein Rahmen."""
        n = len(along)
        step = 1 if start == 0 else -1
        limit = max(3, int(0.05 * min(h, w)))
        idx = []
        i = start
        while 0 <= i < n and len(idx) < limit and along[i]:
            idx.append(i)
            i += step
        if not idx:
            return []
        inner = i                                   # erste Linie hinter dem Band
        m_ = len(perp_full)
        lo = max(0, min(perp_lo, perp_hi))
        hi = min(m_, max(perp_lo, perp_hi))
        if not (0 <= inner < n and (line_edge[inner] or
                                    (hi > lo and bool(perp_full[lo:hi].all())))):
            return []                               # keine Background-Begrenzung
        for j in idx:
            o = j - step                            # aeussere Nachbarlinie
            if not (o < 0 or o >= n or line_edge[o]):
                return []                           # Aussenrand nicht sauber
        return idx

    def span_edge(lines: np.ndarray, lo: int, hi: int) -> np.ndarray:
        """Flag pro Linie (0. Achse von `lines`): ueber dem Span [lo:hi] der
        1. Achse fast nur eine einzige Farbe. `lines` sind die Rohpixel mit
        Farbkanal am Ende (h, w, 3); liegt die Farbkanalachse vorn
        (z.B. par.T -> (3, h, w)), wird sie an das Ende gebracht."""
        if lines.ndim == 3 and lines.shape[0] == 3:
            lines = np.moveaxis(lines, 0, -1)
        if hi - lo < 4:
            return np.zeros(len(lines), dtype=bool)
        out = np.zeros(len(lines), dtype=bool)
        for k, ln in enumerate(lines):
            pts = ln[lo:hi].reshape(-1, ln.shape[-1])
            med = np.median(pts, axis=0)
            if bool((np.abs(pts - med).max(axis=1) < 16).mean() >= 0.98):
                out[k] = True
        return out

    # Reihenfolge der band()-Aufrufe: erst die senkrechten Randspalten ueber
    # den vollen Zeilen-Span, dann die Zeilenbaender innerhalb des Seiten-
    # Spanns, schliesslich die restlichen Seitenbaender innerhalb des
    # Zeilen-Spanns. Die `*_edge`-Flags stehen jeweils auf der Achse der
    # Band-Linien selbst (Spaltenflags laengs Spaltenachse, Zeilenflags
    # laengs Zeilenachse); nur `perp_full` wird auf der Gegenachse indiziert.
    col_edge_full = span_edge(np.swapaxes(par, 0, 1), 0, h)
    left_band = band(0, 0, h, row_full_bg, col_band_flags, col_edge_full)
    right_band = band(w - 1, 0, h, row_full_bg, col_band_flags, col_edge_full)
    x_lo = max(left_band) + 1 if left_band else 0   # Span innhalb der Seitenbaender
    x_hi = min(right_band) if right_band else w
    row_edge_span = span_edge(par, x_lo, x_hi)

    frame_rows = np.zeros(h, dtype=bool)
    top_band = band(0, x_lo, x_hi, col_full_bg, row_band_flags, row_edge_span)
    bottom_band = band(h - 1, x_lo, x_hi, col_full_bg, row_band_flags, row_edge_span)
    frame_rows[top_band] = True
    frame_rows[bottom_band] = True

    y_lo = max(top_band) + 1 if top_band else 0     # Span innhalb der oberen/unteren Baender
    y_hi = min(bottom_band) if bottom_band else h
    col_edge_span = span_edge(np.swapaxes(par, 0, 1), y_lo, y_hi)
    frame_cols = np.zeros(w, dtype=bool)
    frame_cols[band(0, y_lo, y_hi, row_full_bg, col_band_flags, col_edge_span)] = True
    frame_cols[band(w - 1, y_lo, y_hi, row_full_bg, col_band_flags, col_edge_span)] = True

    # Randzonen des Panels: vom aeusseren Rand bis zu m Nicht-Rahmenlinien;
    # ein davor liegendes Rahmenband wird uebersprungen, zaehlt aber nie mit.
    def zone(forward: bool, flags: np.ndarray, size: int) -> list[int]:
        lines, seen = [], 0
        for i in (range(size) if forward else range(size - 1, -1, -1)):
            if flags[i]:
                continue
            if seen >= m:
                break
            lines.append(i)
            seen += 1
        return lines

    strip_rows = sorted(set(zone(True, frame_rows, h)) | set(zone(False, frame_rows, h)))
    strip_cols = sorted(set(zone(True, frame_cols, w)) | set(zone(False, frame_cols, w)))
    px = [par[i].reshape(-1, 3) for i in strip_rows] + \
         [par[:, j].reshape(-1, 3) for j in strip_cols]
    bg = np.median(np.concatenate(px), axis=0)
    content = (np.abs(par - bg).max(axis=2) >= 24)     # True = Pixel mit Inhalt
    # Rahmenzeilen (-) und Rahmenspalten (|) ueber Maskenform OR-verknuepfen;
    # bei nicht-quadratischen Panels ergibt ein direktes `|` von (h,) und
    # (w,1) eine falsche (w,h)-Masche und Indexfehler.
    content[np.repeat(frame_rows[:, None], w, axis=1) |
            np.repeat(frame_cols[None, :], h, axis=0)] = False  # Rahmen ist kein Inhalt
    row_cov = content.mean(axis=1)                     # Inhaltsanteil pro Zeile
    col_cov = content.mean(axis=0)                     # Inhaltsanteil pro Spalte

    def looks_like_text(cov: np.ndarray) -> bool:
        """Wenig Deckung und viele schmale Zeilengruppen = Beschriftungstext."""
        groups = _split_at_gaps(cov, thr, 3)
        if not groups:
            return False
        total = sum(e - s for s, e in groups)
        thin = sum(1 for s, e in groups if e - s <= 14) / len(groups)
        return float(cov.mean()) < 0.35 and (len(groups) >= 2 or total <= 0.3 * len(cov)) \
            and thin >= 0.6

    # --- Querschnitt: Textzeilen unter dem Bild ---------------------------
    # Vertragsregel (einheitlich, auch in den Tests): der Schnitt erfolgt am
    # Anfang der Beschriftung, wobei die Rinne zwischen Bild und Text erhalten
    # bleibt; die scharfe Kante (z.B. untere Bildkante) wird innerhalb +/-2 px
    # nachgeschnappt. Der Rest bis zum Panelrand faellt weg.
    glist = _split_at_gaps(row_cov, thr, max(10, int(0.04 * h)))
    pic_bottom = None
    for s, e in glist:                                 # nur das erste grosse Feld oben ist das Bild
        if s > 0.3 * h:
            break                                      # erstes grosses Feld beginnt zu tief
        if e - s >= 0.45 * h:                          # Hauptbild: hoch genug
            pic_bottom = e
        break
    if pic_bottom is not None and pic_bottom < h - 2:
        rest = row_cov[pic_bottom:]                    # alles unterhalb des Bildes
        if looks_like_text(rest):                      # darunter sitzt Beschriftung
            cut = _gap_start(row_cov, pic_bottom, thr, max(10, int(0.05 * h)))
            if cut is None:
                cut = pic_bottom
            strong = _strong_edge(row_cov, cut, max(6, int(0.02 * h)), thr)
            if strong is not None:
                cut = strong                           # an der scharfen Kante einrasten
            cut = max(int(0.4 * h), min(h, cut))
            if cut < h:
                return (l, t, r, t + cut)
        elif frame_rows.any():
            # Unterer Rahmen wurde aus der Maske entfernt; die verbleibende
            # letzte Gruppe endet an der Rinne ueber dem Rahmen -> dorthin
            # schneiden (Rahmen und moglicher Text darunter entfallen).
            # `lim` nach derselben Regel wie in band(); nur Indizes im
            # unteren Bereich zaehlen, damit ein ausschliesslich oberer
            # Rahmenband den Schnitt nicht ausloest.
            lim = max(3, int(0.05 * min(h, w)))
            last_s = glist[-1][0] if glist else None
            fr_idx = np.nonzero(frame_rows)[0]
            low_band = [int(i) for i in fr_idx if i >= h - lim]
            if low_band and low_band[0] == h - len(low_band) \
                    and last_s is not None and last_s >= int(0.4 * h) \
                    and last_s < low_band[0]:
                return (l, t, r, t + last_s)
        return box                                     # nichts abzuschneiden

    # --- Laengsschnitt: Textspalte links oder rechts neben dem Bild -------
    vg = _split_at_gaps(col_cov, thr, max(10, int(0.04 * w)))
    if len(vg) == 2:
        (xa, xb), (ya, yb) = vg
        gap = ya - xb
        if 5 <= gap <= 0.25 * w:
            def local_row_profile(x0: int, x1: int) -> np.ndarray:
                """Zeilenprofil NUR fuer das Spaltenintervall [x0:x1]."""
                return content[:, x0:x1].mean(axis=1)

            def extent(x0, x1):
                rr = _split_at_gaps(local_row_profile(x0, x1), thr, max(10, int(0.05 * h)))
                return float(max((e - s) for s, e in rr)) / h if rr else 0.0

            def text_col(x0, x1):
                return looks_like_text(col_cov[x0:x1]) or looks_like_text(local_row_profile(x0, x1))

            le, ri = extent(xa, xb), extent(ya, yb)
            if le >= 0.8 and ri <= 0.9 and text_col(ya, yb):   # links Bild, rechts Text
                nr = max(int(0.4 * w), min(w, _gap_start(col_cov, xb, thr, max(10, int(0.05 * w))) or (xb + gap // 2)))
                if nr < w:
                    return (l, t, l + nr, b)
            elif ri >= 0.8 and le <= 0.9 and text_col(xa, xb): # rechts Bild, links Text
                nl = min(w - int(0.4 * w), max(0, ya - gap // 2))
                if nl > 0:
                    return (l + nl, t, r, b)
    return box


# ----------------------------------------------------------------------------
# Ordner / used.md / Dateinamen
# ----------------------------------------------------------------------------
def read_used(used_md: Path) -> set[str]:
    names: set[str] = set()
    if used_md.exists():
        for line in used_md.read_text(encoding="utf-8-sig", errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            names.add(re.split(r"\s+", line)[0].lower())
    return names


def pick_folder(out_root: Path) -> Path:
    used = read_used(out_root / "used.md")
    n = 1
    while True:
        name = f"grid{n}"
        folder = out_root / name
        busy = folder.exists() and any(folder.iterdir())
        if name.lower() not in used and not busy:
            return folder
        n += 1


def append_used(used_md: Path, name: str) -> None:
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    prefix = ""
    if used_md.exists() and used_md.stat().st_size > 0:
        with open(used_md, "rb") as f:
            f.seek(-1, os.SEEK_END)
            if f.read(1) not in (b"\n", b"\r"):
                prefix = "\n"
    with open(used_md, "a", encoding="utf-8", newline="\n") as f:
        f.write(f"{prefix}{name}  # {stamp}\n")


def make_names(count: int) -> list[str]:
    names, seen = [], set()
    for i in range(1, count + 1):
        while True:
            suffix = "".join(random.choices(string.ascii_lowercase, k=3))
            if suffix not in seen:
                seen.add(suffix)
                break
        names.append(f"{i}{suffix}")
    return names


# ----------------------------------------------------------------------------
# Hauptablauf pro Bild
# ----------------------------------------------------------------------------
def process(path: Path, port: int, out_root: Path, debug: bool,
            with_captions: bool = True) -> tuple[Path, list[Path]]:
    """Split a grid using the local vision server at ``port`` and save RGB PNGs.

    Return (output folder, saved paths) in row order, left to right.
    Use an available ``gridN`` folder under ``out_root`` and record its name
    in ``out_root/used.md`` after saving all panels. ``with_captions=False``
    attempts to trim captions below panels; some boxes may remain unchanged.
    ``debug`` also saves ``grid_splitter_debug.png`` beside this module.

    Raise RuntimeError if none of three model responses yields valid boxes.
    Image, filesystem, HTTP, and response-structure errors propagate;
    saving errors can leave partial output.
    """
    log(f"\n=== {path} ===")
    img = Image.open(path)
    img.load()
    W, H = img.size
    gray = np.asarray(img.convert("L"), dtype=np.float32)
    mask = bg_mask(img)

    boxes = None
    for attempt in range(3):
        log(f"[INFO] Frage Qwen3-VL (Versuch {attempt + 1}/3) ...")
        text, sent = ask_model(port, img, attempt)
        if debug:
            log("[DEBUG] Antwort:\n" + text)
        boxes = validate(parse_boxes(text, sent, (W, H)), W, H)
        if boxes:
            break
        log("[WARN] Antwort unbrauchbar, neuer Versuch ...")
    if not boxes:
        raise RuntimeError("Das Modell lieferte keine brauchbaren Rahmen. Nichts gespeichert.")

    boxes = sort_boxes([snap_box(gray, mask, b, W, H) for b in boxes])
    log(f"[OK] {len(boxes)} Panels erkannt.")

    if not with_captions:
        boxes = [strip_caption(img, gray, mask, b, W, H) for b in boxes]
        log("[INFO] Beschriftungen werden abgeschnitten (nur Bild).")

    if debug:
        from PIL import ImageDraw
        dbg = img.convert("RGB")
        dr = ImageDraw.Draw(dbg)
        for i, b in enumerate(boxes, 1):
            dr.rectangle(b, outline=(0, 255, 0), width=3)
            dr.text((b[0] + 6, b[1] + 6), str(i), fill=(255, 255, 0))
        dbg.save(SCRIPT_DIR / "grid_splitter_debug.png")
        log(f"[DEBUG] Kontrollbild: {SCRIPT_DIR / 'grid_splitter_debug.png'}")

    folder = pick_folder(out_root)
    folder.mkdir(parents=True, exist_ok=True)
    saved: list[Path] = []
    for name, box in zip(make_names(len(boxes)), boxes):
        fp = folder / f"{name}.png"
        img.convert("RGB").crop(box).save(fp, "PNG")
        saved.append(fp)
        log(f"   {name}.png  {box[2] - box[0]}x{box[3] - box[1]}")
    append_used(out_root / "used.md", folder.name)
    log(f"[FERTIG] Gespeichert in {folder}  (in used.md eingetragen)")
    return folder, saved


_run_lock = threading.Lock()


def split_image(image_path, out_root: Path = OUT_ROOT, vl: str = DEFAULT_VL,
                ngl: int | None = None, debug: bool = False, on_log=None,
                with_captions: bool = True) -> tuple[Path, list[Path]]:
    """Split a grid for callers such as webui.py; return (folder, saved paths).

    Save panels in reading order under ``out_root/gridN`` and record the
    folder in ``out_root/used.md``. Captions are included by default;
    ``with_captions=False`` attempts to trim them below each panel.
    ``debug`` also writes a control image beside this module.

    Serialize calls and reuse an available vision server. Otherwise start
    one with ``vl`` (``qwen`` or ``gemma``) and ``ngl`` GPU layers (None
    selects automatically), then stop that server on exit. These options
    do not change a reused server. ``on_log`` receives message strings;
    exceptions from the callback are ignored.

    Raise RuntimeError for a missing input file, unavailable server assets,
    failed server readiness, or unusable panel detections. An unknown ``vl``
    raises KeyError when starting a server. Image, filesystem, HTTP, and
    response-structure errors propagate without conversion to RuntimeError.
    """
    global _log_cb
    path = Path(image_path)
    if not path.is_file():
        raise RuntimeError(f"Datei nicht gefunden: {path}")
    with _run_lock:
        _log_cb = on_log
        proc = None
        try:
            out_root = Path(out_root)
            out_root.mkdir(parents=True, exist_ok=True)
            port = next((p for p in REUSE_PORTS if server_has_vision(p)), None)
            if port is not None:
                log(f"[INFO] Vision-Server auf Port {port} gefunden, wird benutzt.")
            else:
                proc = start_server(ngl, vl)
                port = VL_PORT
            return process(path, port, out_root, debug, with_captions)
        finally:
            stop_server(proc)
            _log_cb = None


def main() -> None:
    """Split grid images from CLI arguments, prompting for a path if omitted.

    Include captions unless ``--no-captions`` requests heuristic trimming.
    Stop a server started here unless ``--keep-server`` is set. Continue
    after per-image RuntimeError failures and exit with status 1 if any occur,
    or 0 otherwise. Missing files and server startup RuntimeErrors become
    SystemExit; other image, filesystem, and request errors propagate.
    """
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except Exception:
        pass

    ap = argparse.ArgumentParser(description="Bildgitter per Qwen3-VL in Einzelbilder schneiden")
    ap.add_argument("images", nargs="*", help="Pfad(e) zu den Gitter-Bildern")
    ap.add_argument("--ngl", type=int, default=None, help="GPU-Layer (Standard: automatisch)")
    ap.add_argument("--model", choices=sorted(VL_SETS), default=DEFAULT_VL, help="Vision-Modell (Standard: qwen)")
    ap.add_argument("--keep-server", action="store_true", help="Server nach dem Lauf nicht beenden")
    ap.add_argument("--debug", action="store_true", help="Modellantwort und Kontrollbild ausgeben")
    ap.add_argument("--out-root", default=str(OUT_ROOT), help="Basisordner (Standard: workflow)")
    ap.add_argument("--no-captions", action="store_true",
                    help="Panels OHNE Beschriftung schneiden (nur das Bild, Text unten abschneiden)")
    args = ap.parse_args()

    images = [Path(p.strip('"')) for p in args.images]
    if not images:
        p = input("Pfad zum Gitter-Bild: ").strip().strip('"')
        if not p:
            return
        images = [Path(p)]
    for p in images:
        if not p.is_file():
            raise SystemExit(f"[FEHLER] Datei nicht gefunden: {p}")

    out_root = Path(args.out_root)
    out_root.mkdir(parents=True, exist_ok=True)

    port = next((p for p in REUSE_PORTS if server_has_vision(p)), None)
    proc = None
    if port is not None:
        log(f"[INFO] Vision-Server auf Port {port} gefunden, wird benutzt.")
    else:
        try:
            proc = start_server(args.ngl, args.model)
        except RuntimeError as e:
            raise SystemExit(f"[FEHLER] {e}")
        port = VL_PORT

    ok = True
    try:
        for p in images:
            try:
                process(p, port, out_root, args.debug, with_captions=not args.no_captions)
            except RuntimeError as e:
                log(f"[FEHLER] {e}")
                ok = False
    finally:
        if proc is not None and not args.keep_server:
            stop_server(proc)

    if "PROMPT" not in os.environ:       # per Doppelklick / Drag&Drop gestartet -> Fenster offen halten
        input("\nEnter zum Beenden ...")
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
